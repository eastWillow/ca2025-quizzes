{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug RV32EMU",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/q1-uf8-complete/test.elf", // ELF 檔案
            "miDebuggerPath": "riscv-none-elf-gdb", // GDB path
            "miDebuggerServerAddress": ":1234",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ]
        }
    ]
}